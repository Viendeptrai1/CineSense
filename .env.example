# CineSense Environment Configuration
# Copy this file to .env and update values as needed

# ============================================
# Database (SQLite file)
# ============================================
DATABASE_URL=sqlite:///./data/cinesense.db

# ============================================
# Embedding Model Configuration
# ============================================
# English-first base encoder for Notebook_Report retrieval fine-tuning / export
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Runtime recommendation artifact directory
RECOMMENDER_ARTIFACT_DIR=Notebook_Report/training/artifacts/sbert_en_finetuned_latest

# ABSA checkpoint folder under Notebook_Report/absa/artifacts/ (API + notebook 06)
ABSA_ARTIFACT_NAME=absa_distilroberta_latest
# Optional: HuggingFace id when training notebook 04 (default distilroberta-base)
# ABSA_MODEL_NAME=distilroberta-base

# Gemini offline LLM-as-a-Judge (evaluation only; do not hard-code in notebooks/scripts)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Notebook 03b pseudo-labels (sentence-level + VADER mặc định)
# ABSA_AUTOLABEL_MODE=sentence
# ABSA_AUTOLABEL_SENTIMENT=vader

# ============================================
# ETL Pipeline Configuration
# ============================================
BATCH_SIZE=32
LOG_LEVEL=INFO

# ============================================
# TMDB API Configuration
# ============================================
# Get your API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3
# Language for fetching English metadata (title, overview)
TMDB_LANGUAGE=en-US
# Number of pages to fetch from popular/top_rated (20 movies per page)
TMDB_PAGES_TO_FETCH=50
